        <mxCell id="pl07ghJkXNtjpxfqh3xb-23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Task 15&lt;/b&gt; shows&amp;nbsp;&lt;div&gt;&lt;b&gt;significant&lt;/b&gt; differences across&lt;/div&gt;&lt;div&gt;&amp;nbsp;particpant groups - Median DOU:&amp;nbsp;&amp;nbsp;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&quot;Formula construction&quot;:&amp;nbsp;0.545&lt;/li&gt;&lt;li&gt;others: 1.000&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;effect sizes large: cliffs delta of&amp;nbsp;&lt;/div&gt;&lt;div&gt;1 (D vs. F), or&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-0.755 (S vs. F)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">

        <mxCell id="pl07ghJkXNtjpxfqh3xb-41" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="no significant effects except:&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CELL&lt;/b&gt;:&lt;div&gt;&quot;dynamic sketch construction&quot;: median = 1, CLD = a&lt;/div&gt;&lt;div&gt;&quot;formula construction&quot;: median = 1, CLD = b&lt;/div&gt;&lt;div&gt;&quot;static sketch construction&quot;: median = 1, CLD = ab&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;LIT&lt;/b&gt;:&lt;/div&gt;&lt;div&gt;&lt;div&gt;dynamic sketch construction&quot;: median = 0.875, CLD = b&lt;/div&gt;&lt;div&gt;&quot;formula construction&quot;: median = 1, CLD = a&lt;/div&gt;&lt;div&gt;&quot;static sketch construction&quot;: median = 1, CLD = ab&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
